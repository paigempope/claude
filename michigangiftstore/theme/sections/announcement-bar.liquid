{%- comment -%}
  Rotating announcement + optional holiday ship-by countdown (date set in theme settings).
{%- endcomment -%}
<div class="announcement" data-announcement>
  <div class="announcement__inner">
    {%- if settings.deadline_enable and settings.deadline_date != blank -%}
      {%- assign deadline_ts = settings.deadline_date | append: 'T23:59:00' | date: '%s' -%}
      {%- assign now_ts = 'now' | date: '%s' -%}
      {%- if deadline_ts > now_ts -%}
        <span class="announcement__deadline" data-deadline="{{ settings.deadline_date }}T23:59:00">
          🎄 {{ settings.deadline_label }} <span data-countdown></span>
        </span>
      {%- endif -%}
    {%- endif -%}

    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }} data-announcement-slide{% unless forloop.first %} hidden{% endunless %}>
        {{ block.settings.text }}
        {%- if block.settings.link != blank and block.settings.link_label != blank -%}
          &nbsp;<a href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </span>
    {%- endfor -%}

    {%- if settings.sister_brand_url != blank -%}
      <span class="announcement__sister">· {{ settings.sister_brand_teaser }} <a href="{{ settings.sister_brand_url }}" rel="noopener">{{ settings.sister_brand_name }} →</a></span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders $75+" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
