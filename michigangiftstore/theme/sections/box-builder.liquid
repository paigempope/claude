{%- comment -%}
  Shelf builder: Size → Fill it → Postcard + send → Review. Flat price per size.
  Needs the "Build Your Own Half Box" and "Build Your Own Full Box" products (see data/products.csv).
{%- endcomment -%}
<section class="section{% if section.settings.water %} section--water{% endif %}" id="build">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.as_h1 -%}<h1 class="h2-size">{{ section.settings.heading }}</h1>{%- else -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <p class="lede" style="margin:0">{{ section.settings.text }}</p>
    </div>
    <div class="bb" data-builder>
      <div class="bb-steps" data-bb-steps role="tablist" aria-label="{{ 'boxes.build_steps' | t }}"></div>
      <div class="bb-body">
        <div class="bb-main" data-bb-main>
          <noscript><p>{{ 'boxes.needs_js' | t }}</p></noscript>
        </div>
        <aside class="bb-side" data-bb-side aria-live="polite"></aside>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Box builder",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "or just pack it yourself" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build a box from five Michigan shelves" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick a size, then fill it from the shelves: pop, salty, sweet, Up North pantry and a keepsake. Every box comes out balanced and all Michigan." },
    { "type": "checkbox", "id": "as_h1", "label": "Use as page title (H1)", "default": false },
    { "type": "checkbox", "id": "water", "label": "Lake-blue background", "default": false }
  ],
  "presets": [{ "name": "Box builder" }]
}
{% endschema %}
