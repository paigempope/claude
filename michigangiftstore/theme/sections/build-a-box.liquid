{%- comment -%}
  Build-your-own box. No app needed:
  - "Box product": a product whose variants are the box sizes, in order (e.g. Small / Classic / Big),
    priced as the packing + card fee (can be $0).
  - "Items collection": the products customers can choose (single-variant products work best).
  On submit, JS adds the box variant and every chosen item in one /cart/add.js call.
  Each line gets a "Box" property (shown on the order) plus a hidden _box_id so the packers can group them.
{%- endcomment -%}
{%- assign box = section.settings.box_product -%}
{%- assign items = section.settings.collection -%}
{%- assign counts = section.settings.counts | split: ',' -%}
<section class="section" data-bab>
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h1 style="font-size:clamp(2.2rem,4.5vw,3.8rem);margin:0">{{ section.settings.heading }}</h1>
      </div>
      <p class="lede" style="margin:0">{{ section.settings.subheading }}</p>
    </div>

    <div class="bab">
      <div>
        {%- if items != blank -%}
          <div class="bab__grid">
            {%- for p in items.products limit: 60 -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              <div class="bab-item" data-bab-item data-variant="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ p.title | escape }}" data-img="{% if p.featured_media %}{{ p.featured_media | image_url: width: 160 }}{% endif %}">
                <div class="bab-item__media">
                  {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', alt: p.featured_media.alt | default: p.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                </div>
                {%- if p.metafields.custom.region.value != blank -%}<span class="card__region">{{ p.metafields.custom.region.value }}</span>{%- endif -%}
                <span class="bab-item__title">{{ p.title }}</span>
                <div class="bab-item__qty">
                  <span class="price" style="font-size:.95rem">{{ v.price | money }}</span>
                  {%- if p.available -%}
                    <span class="qty-mini">
                      <button type="button" data-bab-minus aria-label="{{ 'products.decrease' | t }}: {{ p.title | escape }}">−</button>
                      <span data-bab-qty>0</span>
                      <button type="button" data-bab-plus aria-label="{{ 'products.increase' | t }}: {{ p.title | escape }}">+</button>
                    </span>
                  {%- else -%}
                    <span class="form-note">{{ 'products.sold_out' | t }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="cant-ship">{{ 'bab.setup' | t }}</p>
        {%- endif -%}
      </div>

      <aside class="bab__summary" aria-live="polite">
        <h3>{{ section.settings.summary_heading }}</h3>
        <div class="bab__sizes" role="group" aria-label="{{ 'bab.box_size' | t }}">
          {%- for variant in box.variants -%}
            {%- assign c = counts[forloop.index0] | default: 6 | strip -%}
            <button type="button" class="bab__size" data-bab-size data-variant="{{ variant.id }}" data-count="{{ c }}" data-price="{{ variant.price }}" aria-pressed="{% if forloop.index0 == section.settings.default_size %}true{% else %}false{% endif %}">
              {{ variant.title }}<br><span style="font-weight:400">{{ 'bab.items' | t: count: c }}</span>
            </button>
          {%- endfor -%}
        </div>
        <div class="bab__slots" data-bab-slots></div>
        <div class="progress"><div class="progress__bar" data-bab-progress></div></div>
        <p class="form-note" data-bab-status style="margin:8px 0 0"></p>
        <div class="bab__total"><span>{{ 'bab.total' | t }}</span><span data-bab-total>{{ 0 | money }}</span></div>
        <label class="label" for="BabNote">{{ 'cart.gift_message' | t }}</label>
        <textarea class="input" id="BabNote" maxlength="300" data-bab-note placeholder="{{ 'cart.gift_message_placeholder' | t }}" style="min-height:80px;margin-bottom:12px"></textarea>
        <button type="button" class="btn btn--block" data-bab-submit aria-disabled="true" {% if box == blank %}disabled{% endif %}>{{ 'bab.add' | t }}</button>
        <p class="form-note center">{{ section.settings.note }}</p>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Build a box",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "or just pack it yourself" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your own Michigan box" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick a box size, fill it with the classics they miss, and we'll pack it by hand with your note." },
    { "type": "product", "id": "box_product", "label": "Box product (variants = sizes)" },
    { "type": "text", "id": "counts", "label": "Items per size (comma separated, same order as variants)", "default": "4,6,10" },
    { "type": "range", "id": "default_size", "label": "Default size (0 = first)", "min": 0, "max": 2, "step": 1, "default": 1 },
    { "type": "collection", "id": "collection", "label": "Items to choose from" },
    { "type": "text", "id": "summary_heading", "label": "Summary heading", "default": "Your box" },
    { "type": "text", "id": "note", "label": "Note under button", "default": "Free shipping when your box totals $75+" }
  ],
  "presets": [{ "name": "Build a box" }]
}
{% endschema %}
