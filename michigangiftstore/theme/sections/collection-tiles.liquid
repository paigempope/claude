<section class="section{% if section.settings.tight %} section--tight{% endif %}">
  <div class="page-width">
    <div class="section-head{% if section.settings.center %} section-head--center{% endif %}">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a class="link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="tiles{% if section.blocks.size >= 6 %} tiles--6{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="tile reveal" href="{{ c.url | default: '#' }}" style="--tile-bg: {{ block.settings.bg }}" {{ block.shopify_attributes }}>
          <span class="tile__img">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
            {%- elsif c.featured_image -%}
              {{ c.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              <span class="tile__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
            {%- endif -%}
          </span>
          <span class="tile__title">{{ block.settings.title | default: c.title }}</span>
          {%- if c.products_count > 0 -%}<span class="tile__count">{{ c.products_count }} {{ 'collections.items' | t }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "so, what are you craving?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Mitten" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop everything" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "center", "label": "Center heading", "default": false },
    { "type": "checkbox", "id": "tight", "label": "Less padding", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image (cutout on transparent works best)" },
        { "type": "text", "id": "emoji", "label": "Fallback emoji", "default": "🥔" },
        { "type": "color", "id": "bg", "label": "Circle color", "default": "#F3EEE2" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Chips & Snacks", "emoji": "🥔", "bg": "#F9E6B3" } },
        { "type": "tile", "settings": { "title": "Michigan Pop", "emoji": "🥤", "bg": "#F6D2CE" } },
        { "type": "tile", "settings": { "title": "Fudge & Sweets", "emoji": "🍫", "bg": "#E9DCCB" } },
        { "type": "tile", "settings": { "title": "Up North Cherries", "emoji": "🍒", "bg": "#F3C9C5" } },
        { "type": "tile", "settings": { "title": "Pantry & Sauces", "emoji": "🫙", "bg": "#D8E6D9" } },
        { "type": "tile", "settings": { "title": "Coffee & Breakfast", "emoji": "☕", "bg": "#DCE7EF" } }
      ]
    }
  ]
}
{% endschema %}
