<section class="section{% if section.settings.tight %} section--tight{% endif %}{% if section.settings.water %} section--water{% endif %}">
  <div class="page-width">
    <div class="section-head{% if section.settings.center %} section-head--center{% endif %}">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a class="link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="tiles{% if section.blocks.size >= 6 %} tiles--6{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="tile reveal" href="{{ c.url | default: '#' }}" style="--tile-bg: {{ block.settings.bg }}" {{ block.shopify_attributes }}>
          <span class="tile__img">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
            {%- elsif c.featured_image -%}
              {{ c.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              <span class="tile__icon">{% render 'icon', name: block.settings.icon %}</span>
            {%- endif -%}
          </span>
          <span class="tile__title">{{ block.settings.title | default: c.title }}</span>
          {%- if c.products_count > 0 -%}<span class="tile__count">{{ c.products_count }} {{ 'collections.items' | t }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "so, what are you craving?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Mitten" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop everything" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "center", "label": "Center heading", "default": false },
    { "type": "checkbox", "id": "tight", "label": "Less padding", "default": true },
    { "type": "checkbox", "id": "water", "label": "Lake-blue background", "default": false }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image (cutout on transparent works best)" },
        { "type": "select", "id": "icon", "label": "Icon (shown when no image)", "options": [{"value":"chips","label":"Chip bag"},{"value":"pop","label":"Pop can"},{"value":"fudge","label":"Fudge"},{"value":"cherry","label":"Cherries"},{"value":"nut","label":"Peanut"},{"value":"pine","label":"Pine tree"},{"value":"mug","label":"Coffee mug"},{"value":"jar","label":"Jar"},{"value":"bottle","label":"Sauce bottle"},{"value":"lighthouse","label":"Lighthouse"},{"value":"crate","label":"Crate"},{"value":"gift","label":"Gift"},{"value":"box","label":"Box"},{"value":"wave","label":"Lake waves"},{"value":"mitten","label":"Mitten"}], "default": "chips" },
        { "type": "color", "id": "bg", "label": "Circle color", "default": "#DCEDF7" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Chips & Snacks", "icon": "chips", "bg": "#FBEFC4" } },
        { "type": "tile", "settings": { "title": "Michigan Pop", "icon": "pop", "bg": "#DCEDF7" } },
        { "type": "tile", "settings": { "title": "Fudge & Sweets", "icon": "fudge", "bg": "#F7DAD6" } },
        { "type": "tile", "settings": { "title": "Up North Cherries", "icon": "cherry", "bg": "#F7DAD6" } },
        { "type": "tile", "settings": { "title": "Pantry & Sauces", "icon": "jar", "bg": "#D9EBDF" } },
        { "type": "tile", "settings": { "title": "Coffee & Breakfast", "icon": "mug", "bg": "#DCEDF7" } }
      ]
    }
  ]
}
{% endschema %}
