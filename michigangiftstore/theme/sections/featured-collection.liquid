{%- assign c = section.settings.collection -%}
<section class="section{% if section.settings.paper %} section--paper{% endif %}{% if section.settings.water %} section--water{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | default: c.title }}</h2>
      </div>
      {%- if c != blank -%}<a class="link-arrow" href="{{ c.url }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="{% if section.settings.layout == 'scroller' %}scroller scroller--desktop-grid{% else %}grid grid--4{% endif %}">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><div class="card__body"><span class="card__region">Region</span><h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3><div class="card__foot"><span class="price">$12</span></div></div></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "what Michiganders miss most" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "select", "id": "layout", "label": "Mobile layout", "options": [{ "value": "grid", "label": "2-up grid" }, { "value": "scroller", "label": "Swipe row" }], "default": "scroller" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "checkbox", "id": "water", "label": "Lake-blue background", "default": false },
    { "type": "checkbox", "id": "paper", "label": "White background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
