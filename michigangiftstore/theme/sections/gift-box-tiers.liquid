{%- comment -%}
  Good / better / best gift boxes. Each block points at a real product so price,
  image and add-to-cart stay in sync with Shopify; copy fields override for merchandising.
{%- endcomment -%}
<section class="section section--{{ section.settings.scheme }}">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <article class="tier reveal{% if block.settings.featured %} tier--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.flag != blank -%}<span class="tier__flag stamp stamp--solid">{{ block.settings.flag }}</span>{%- endif -%}
          <div class="tier__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 900px) 33vw, 100vw', alt: '' }}
            {%- elsif p.featured_media -%}
              {{ p.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 900px) 33vw, 100vw', alt: p.featured_media.alt | default: p.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="tier__body">
            <span class="card__region">{{ block.settings.eyebrow }}</span>
            <h3 class="tier__name">{{ block.settings.title | default: p.title }}</h3>
            <div class="tier__price">
              {%- if p != blank -%}{{ p.price | money_without_trailing_zeros }}{%- else -%}{{ block.settings.fallback_price }}{%- endif -%}
              <small>· {{ block.settings.count }}</small>
            </div>
            <p style="color:var(--ink-soft);font-size:.95rem">{{ block.settings.blurb }}</p>
            <ul class="tier__list">
              {%- assign lines = block.settings.contents | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}{%- endfor -%}
            </ul>
            {%- if p != blank and p.available -%}
              {%- if p.has_only_default_variant -%}
                <button type="button" class="btn btn--block{% unless block.settings.featured %} btn--secondary{% endunless %}" data-quick-add="{{ p.selected_or_first_available_variant.id }}">{{ 'products.add_to_cart' | t }} · {{ p.price | money_without_trailing_zeros }}</button>
              {%- else -%}
                <a class="btn btn--block{% unless block.settings.featured %} btn--secondary{% endunless %}" href="{{ p.url }}">{{ 'products.choose_options' | t }}</a>
              {%- endif -%}
              <a class="link-arrow" href="{{ p.url }}" style="justify-content:center;margin-top:12px">{{ 'products.see_inside' | t }}</a>
            {%- else -%}
              <a class="btn btn--block btn--secondary" href="{{ p.url | default: routes.all_products_collection_url }}">{{ 'products.see_inside' | t }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}<p class="center mt-l" style="font-size:.95rem">{{ section.settings.footnote }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gift box tiers",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [{ "value": "navy", "label": "Navy" }, { "value": "paper", "label": "Paper" }, { "value": "pine", "label": "Pine" }], "default": "navy" },
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "so, how homesick are they?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick a box. We'll pack it tonight." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every box is hand-packed in Michigan with a handwritten card. Prices never go inside." },
    { "type": "inline_richtext", "id": "footnote", "label": "Footnote", "default": "Want to pick every item yourself? <a href=\"/pages/build-a-box\">Build your own box →</a>" }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tier",
      "name": "Box tier",
      "settings": [
        { "type": "product", "id": "product", "label": "Gift box product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The starter" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "fallback_price", "label": "Price shown if no product is picked", "default": "$45" },
        { "type": "text", "id": "count", "label": "Item count", "default": "5 Michigan classics" },
        { "type": "textarea", "id": "blurb", "label": "Blurb" },
        { "type": "textarea", "id": "contents", "label": "Contents (one per line)" },
        { "type": "text", "id": "flag", "label": "Flag (e.g. Most gifted)" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this tier", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift box tiers",
      "blocks": [
        { "type": "tier", "settings": { "eyebrow": "The starter", "title": "The Day Tripper", "fallback_price": "$45", "count": "5 classics · ships free", "blurb": "A quick hit of home for birthdays and 'thinking of you'.", "contents": "Better Made Special BBQ chips\nFaygo Rock & Rye (12 oz can)\nSanders milk chocolate hot fudge\nGermack pistachios\nHandwritten Michigan postcard" } },
        { "type": "tier", "settings": { "eyebrow": "Most gifted", "title": "The Up North", "fallback_price": "$79", "count": "9 classics · ships free", "blurb": "From Detroit to the Straits: chips, pop, fudge and cherries.", "contents": "Everything in The Day Tripper\nMackinac Island fudge (seasonal)\nCherry Republic dried cherries\nGreat Lakes Cherry BBQ kettle chips\nVernors (12 oz can)\nKoeze Cream-Nut peanut butter", "flag": "Most gifted", "featured": true } },
        { "type": "tier", "settings": { "eyebrow": "The whole state", "title": "The Full Mitten", "fallback_price": "$119", "count": "14 classics · ships free", "blurb": "Every region, from Detroit to the U.P., in one keepsake crate.", "contents": "Everything in The Up North\nTrenary Toast from the U.P.\nAmerican Spoon sour cherry preserves\nPop Daddy dill pickle pretzels\nJiffy corn muffin mix from Chelsea\nKeepsake wooden crate" } }
      ]
    }
  ]
}
{% endschema %}
