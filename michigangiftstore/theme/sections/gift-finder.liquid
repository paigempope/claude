{%- comment -%} Gift finder: pick the person, get the box and the reason. Data lives in mgs-data. {%- endcomment -%}
<section class="section section--tight{% if section.settings.water %} section--water{% endif %}" id="finder">
  <div class="page-width">
    <div class="finder" data-finder data-build-url="{{ section.settings.build_link | default: '/pages/build-a-box' }}">
      <div class="finder__head">
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede">{{ section.settings.text }}</p>
        <div class="chips finder__chips" data-finder-chips role="group" aria-label="{{ section.settings.heading | escape }}"></div>
      </div>
      <div class="fres" data-finder-result aria-live="polite">
        <noscript><a class="btn" href="{{ section.settings.build_link | default: '/pages/build-a-box' }}">{{ 'boxes.build' | t }}</a></noscript>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift finder",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "so, who's it for?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick the person. We'll pick the box." },
    { "type": "text", "id": "text", "label": "Text", "default": "Every Michigander misses something different. Tell us who it's for and we'll tell you why this box fits." },
    { "type": "url", "id": "build_link", "label": "Build-a-box link" },
    { "type": "checkbox", "id": "water", "label": "Lake-blue background", "default": true }
  ],
  "presets": [{ "name": "Gift finder" }]
}
{% endschema %}
