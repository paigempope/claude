<section class="page-width section">
  <span class="kicker">{{ 'blog.kicker' | t }}</span>
  <h1 style="font-size:clamp(2.2rem,4.5vw,3.6rem)">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <article class="card reveal">
          <div class="card__media" style="aspect-ratio:4/3">
            {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 750px) 33vw, 100vw', alt: article.image.alt | default: article.title }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </div>
          <div class="card__body">
            <span class="card__region">{{ article.published_at | date: '%b %-d, %Y' }}</span>
            <h2 class="card__title" style="font-size:1.3rem"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="card__origin">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
