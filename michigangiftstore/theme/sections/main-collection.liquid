{%- paginate collection.products by section.settings.per_page -%}
<section class="collection-hero">
  <div class="page-width collection-hero__inner">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / <span aria-current="page">{{ collection.title }}</span></nav>
      {%- if collection.metafields.custom.kicker.value != blank -%}<span class="kicker">{{ collection.metafields.custom.kicker.value }}</span>{%- endif -%}
      <h1>{{ collection.title }}</h1>
    </div>
    {%- if collection.description != blank -%}<div class="rte lede">{{ collection.description }}</div>{%- endif -%}
  </div>
</section>

<div class="page-width" style="padding-bottom:var(--section-space)">
  <div class="toolbar">
    <div class="chips">
      {%- assign chips_menu = linklists[section.settings.chips_menu] -%}
      {%- for link in chips_menu.links -%}
        <a class="chip{% if link.active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
    <div class="sort">
      <label class="visually-hidden" for="SortBy">{{ 'collections.sort_by' | t }}</label>
      <select id="SortBy" data-sort>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </div>
  </div>

  {%- if collection.filters.size > 0 -%}
    <form class="facets" data-facets>
      {%- for filter in collection.filters -%}
        {%- if filter.type == 'list' or filter.type == 'boolean' -%}
          <details>
            <summary class="chip">{{ filter.label }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %} ▾</summary>
            <div class="facets__panel">
              {%- for value in filter.values -%}
                <label>
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} style="accent-color:var(--cherry)">
                  {{ value.label }} <span style="color:var(--ink-soft)">({{ value.count }})</span>
                </label>
              {%- endfor -%}
            </div>
          </details>
        {%- elsif filter.type == 'price_range' -%}
          <details>
            <summary class="chip">{{ filter.label }} ▾</summary>
            <div class="facets__panel" style="display:flex;gap:8px">
              <input class="input" type="number" name="{{ filter.min_value.param_name }}" placeholder="$0" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" aria-label="Min">
              <input class="input" type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" aria-label="Max">
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
      <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
      <noscript><button class="btn btn--sm" type="submit">{{ 'collections.apply' | t }}</button></noscript>
      {%- assign active_count = 0 -%}
      {%- for filter in collection.filters -%}{%- assign active_count = active_count | plus: filter.active_values.size -%}{%- endfor -%}
      {%- if active_count > 0 -%}<a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="link-arrow" style="margin-left:6px">{{ 'collections.clear' | t }}</a>{%- endif -%}
    </form>
  {%- endif -%}

  {%- if collection.products.size > 0 -%}
    <div class="grid grid--4">
      {%- for product in collection.products -%}
        {%- if forloop.index <= 4 -%}{% render 'product-card', product: product, lazy: false %}{%- else -%}{% render 'product-card', product: product %}{%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="cart-empty">
      {% render 'michigan-shape' %}
      <h2>{{ 'collections.empty' | t }}</h2>
      <a class="btn" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a>
    </div>
  {%- endif -%}

  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="Pagination">
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="is-current" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}

  {%- if collection.metafields.custom.seo_copy.value != blank -%}
    <div class="rte mt-l" style="max-width:780px;margin-inline:auto;padding-top:40px;border-top:1px solid var(--line)">{{ collection.metafields.custom.seo_copy | metafield_tag }}</div>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "link_list", "id": "chips_menu", "label": "Quick-link chips menu", "info": "e.g. Under $50 / $50–$100 / $100+ / Up North / The U.P." }
  ]
}
{% endschema %}
