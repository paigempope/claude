<section class="page-width section">
  <span class="kicker">{{ 'collections.kicker' | t }}</span>
  <h1 style="font-size:clamp(2.2rem,4.5vw,3.6rem)">{{ 'collections.all_title' | t }}</h1>
  <div class="tiles">
    {%- for c in collections -%}
      {%- unless c.handle == 'all' or c.handle == 'frontpage' -%}
        <a class="tile reveal" href="{{ c.url }}">
          <span class="tile__img">{%- if c.featured_image -%}{{ c.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<span class="tile__emoji">✋</span>{%- endif -%}</span>
          <span class="tile__title">{{ c.title }}</span>
          <span class="tile__count">{{ c.products_count }} {{ 'collections.items' | t }}</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
