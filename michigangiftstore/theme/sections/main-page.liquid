<section class="text-page">
  {%- if page.metafields.custom.kicker.value != blank -%}<span class="kicker">{{ page.metafields.custom.kicker.value }}</span>{%- endif -%}
  <h1 style="font-size:clamp(2.2rem,4.5vw,3.6rem)">{{ page.title }}</h1>
  <div class="rte lede" style="max-width:none">{{ page.content }}</div>
</section>

{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
