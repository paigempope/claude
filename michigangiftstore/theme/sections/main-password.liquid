<section class="password-page">
  <div style="max-width:620px">
    {% render 'michigan-shape', class: 'notfound__mitten' %}
    <span class="kicker" style="color:var(--sunset);transform-origin:center">{{ 'general.opening_soon' | t }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lede" style="margin:0 auto 24px">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'field-row' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}<p class="form-success">{{ 'newsletter.success' | t }}</p>{%- else -%}
        <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" aria-label="{{ 'newsletter.email' | t }}">
        <button class="btn btn--light" type="submit">{{ 'newsletter.notify' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top:32px">
      <summary style="cursor:pointer">{{ 'general.store_owner' | t }}</summary>
      {%- form 'storefront_password', class: 'field-row', style: 'margin-top:12px' -%}
        <input type="password" name="password" placeholder="Password" aria-label="Password">
        <button class="btn btn--sm" type="submit">{{ 'general.enter' | t }}</button>
        {{ form.errors | default_errors }}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Michigan, shipped home." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Better Made, Faygo, Vernors, Sanders and the rest of the Mitten, shipped anywhere. Get 10% off launch day." }
  ]
}
{% endschema %}
