{%- comment -%}
  Product page. Optional product metafields (namespace "custom"):
    origin_city   single line   "Detroit, MI"
    founded_year  single line   "1930"
    region        single line   "Metro Detroit"
    why_miss      multi-line    A sentence on why Michiganders miss it
    contents      multi-line    Box contents, one per line: "Better Made Special BBQ, 5 oz | Gratiot Ave, Detroit · since 1930"
    shipping_note multi-line    Item-specific shipping info (heat, glass, carbonation)
    ingredients   rich text     Ingredients & allergens
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.custom
  assign featured = current_variant.featured_media | default: product.featured_media
-%}
<section class="page-width" data-product-section data-section-id="{{ section.id }}">
  <nav class="breadcrumbs" aria-label="Breadcrumb" style="padding-top:20px">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> /
    {%- if collection -%}<a href="{{ collection.url }}"> {{ collection.title }}</a> /{%- endif -%}
    <span aria-current="page"> {{ product.title }}</span>
  </nav>

  <div class="product">
    <div class="gallery" data-gallery>
      <div class="gallery__main">
        {%- if featured -%}
          {{ featured | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: featured.alt | default: product.title, data-gallery-main: '' }}
        {%- elsif mf.box_key.value != blank -%}
          <div class="gallery__box" data-box-card="{{ mf.box_key.value }}">
            <span class="bx__who" data-who></span>
            <span class="tray" data-tray></span>
            <span class="bx__box" aria-hidden="true"></span>
          </div>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="gallery__thumb" data-gallery-thumb data-src="{{ media | image_url: width: 1400 }}" data-media-id="{{ media.id }}" aria-label="{{ 'products.view_image' | t: n: forloop.index }}"{% if media.id == featured.id %} aria-current="true"{% endif %}>
              {{ media | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'origin' -%}
            <div class="product__origin" {{ block.shopify_attributes }}>
              {%- if mf.region.value != blank -%}<span class="stamp stamp--lake">{% render 'icon', name: 'pin' %} {{ mf.region.value }}</span>{%- endif -%}
              {%- if mf.origin_city.value != blank -%}<span class="stamp">{{ 'products.made_in' | t: place: mf.origin_city.value }}</span>{%- endif -%}
              {%- if mf.founded_year.value != blank -%}<span class="stamp stamp--cherry">{{ 'products.since' | t: year: mf.founded_year.value }}</span>{%- endif -%}
            </div>

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {%- if product.metafields.reviews.rating.value != blank -%}
              <a href="#reviews" class="card__rating" style="text-decoration:none">
                {% render 'stars', rating: product.metafields.reviews.rating.value.rating %}
                <span>{{ product.metafields.reviews.rating.value.rating | round: 1 }} · {{ product.metafields.reviews.rating_count }} {{ 'products.reviews' | t }}</span>
              </a>
            {%- endif -%}

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              <div class="product__price" data-product-price>{% render 'price', product: product, variant: current_variant %}</div>
              {%- if product.tags contains 'ships-free' -%}<span class="stamp" style="color:var(--pine)">{% render 'icon', name: 'truck' %} {{ 'products.ships_free_long' | t }}</span>{%- endif -%}
              {%- form 'product', product, id: 'InstallmentsForm' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="product__installments">{{ form | payment_terms }}</div>
              {%- endform -%}
            </div>

          {%- when 'why_miss' -%}
            {%- if mf.why_miss.value != blank -%}
              <div class="why-miss" {{ block.shopify_attributes }}><p>{{ mf.why_miss.value }}</p></div>
            {%- endif -%}

          {%- when 'description' -%}
            <div class="rte product__block" {{ block.shopify_attributes }}>{{ product.description }}</div>

          {%- when 'box_panel' -%}
            {%- if mf.box_key.value != blank -%}
              <div class="product__block" data-box-panel="{{ mf.box_key.value }}" {{ block.shopify_attributes }}>
                {%- comment -%} Replaced by the interactive box panel (mgs.js). Plain form if JS is off. {%- endcomment -%}
                {%- form 'product', product -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  <button type="submit" class="btn btn--block" {% unless current_variant.available %}disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
                {%- endform -%}
              </div>
            {%- endif -%}

          {%- when 'contents' -%}
            {%- if mf.contents.value != blank and mf.box_key.value == blank -%}
              <div class="product__block" {{ block.shopify_attributes }}>
                <h2 style="font-size:1.3rem">{{ block.settings.heading }}</h2>
                <ul class="contents">
                  {%- assign rows = mf.contents.value | newline_to_br | split: '<br />' -%}
                  {%- for row in rows -%}
                    {%- assign r = row | strip -%}
                    {%- if r != blank -%}
                      {%- assign parts = r | split: '|' -%}
                      <li><span>{{ parts[0] | strip }}{%- if parts[1] -%}<small>{{ parts[1] | strip }}</small>{%- endif -%}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                {%- if block.settings.note != blank -%}<p class="form-note">{{ block.settings.note }}</p>{%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            {%- if mf.box_key.value != blank -%}{%- continue -%}{%- endif -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              {%- assign product_form_id = 'ProductForm-' | append: section.id -%}
              {%- form 'product', product, id: product_form_id, data-product-form: '' -%}
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <fieldset class="option-group">
                      <legend>{{ option.name }}</legend>
                      <div class="swatches">
                        {%- for value in option.values -%}
                          <label class="swatch">
                            <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}" {% if option.selected_value == value %}checked{% endif %}>
                            <span>{{ value }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                {%- endunless -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <div class="buy-row">
                  <div class="qty">
                    <button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">−</button>
                    <label class="visually-hidden" for="Qty-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                    <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                    <button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">+</button>
                  </div>
                  <button type="submit" name="add" class="btn" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                    {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                  </button>
                </div>
                {%- if block.settings.dynamic_checkout -%}<div style="margin-top:12px">{{ form | payment_button }}</div>{%- endif -%}
              {%- endform -%}
              <p class="ship-eta" data-ship-eta data-cutoff-hour="{{ block.settings.cutoff_hour }}">{{ 'products.ships_from_michigan' | t }}</p>
              <script type="application/json" data-product-json>{{ product.variants | json }}</script>
            </div>

          {%- when 'perks' -%}
            <div class="perks" {{ block.shopify_attributes }}>
              <ul>
                {%- if block.settings.perk_1 != blank -%}<li>{% render 'icon', name: 'gift' %}<span>{{ block.settings.perk_1 }}</span></li>{%- endif -%}
                {%- if block.settings.perk_2 != blank -%}<li>{% render 'icon', name: 'shield' %}<span>{{ block.settings.perk_2 }}</span></li>{%- endif -%}
                {%- if block.settings.perk_3 != blank -%}<li>{% render 'icon', name: 'truck' %}<span>{{ block.settings.perk_3 }}</span></li>{%- endif -%}
                {%- if product.tags contains 'heat-sensitive' -%}<li>{% render 'icon', name: 'snow' %}<span>{{ settings.melt_notice }}</span></li>{%- endif -%}
              </ul>
            </div>

          {%- when 'complementary' -%}
            <div class="product__block" data-complementary data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.limit }}&intent=complementary" {{ block.shopify_attributes }}>
              {%- if recommendations.performed? and recommendations.products_count > 0 -%}
                <h2 style="font-size:1.2rem">{{ block.settings.heading }}</h2>
                {%- for p in recommendations.products -%}
                  <div class="upsell-item">
                    {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<span></span>{%- endif -%}
                    <div><a href="{{ p.url }}" style="text-decoration:none;font-weight:700">{{ p.title }}</a><br>{{ p.price | money }}</div>
                    {%- if p.available -%}<button type="button" class="btn btn--sm btn--secondary" data-quick-add="{{ p.selected_or_first_available_variant.id }}">{{ 'cart.add' | t }}</button>{%- endif -%}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>

          {%- when 'accordion' -%}
            <div class="accordion product__block" {{ block.shopify_attributes }}>
              {%- if mf.ingredients.value != blank -%}
                <details><summary>{{ 'products.ingredients' | t }}</summary><div class="rte">{{ mf.ingredients | metafield_tag }}</div></details>
              {%- endif -%}
              <details>
                <summary>{{ 'products.shipping_returns' | t }}</summary>
                <div class="rte">
                  {%- if mf.shipping_note.value != blank -%}<p>{{ mf.shipping_note.value }}</p>{%- endif -%}
                  {{ block.settings.shipping_text }}
                </div>
              </details>
              {%- if block.settings.extra_title != blank -%}
                <details><summary>{{ block.settings.extra_title }}</summary><div class="rte">{{ block.settings.extra_text }}</div></details>
              {%- endif -%}
            </div>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- unless mf.box_key.value != blank -%}
<div class="sticky-atc" data-sticky-atc aria-hidden="true">
  {%- if featured -%}{{ featured | image_url: width: 100 | image_tag: alt: '' }}{%- endif -%}
  <span class="sticky-atc__title">{{ product.title }}<br><span class="price" style="font-size:.9rem">{{ current_variant.price | money }}</span></span>
  <button type="button" class="btn btn--sm" data-sticky-add tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "blocks": [
    { "type": "@app" },
    { "type": "origin", "name": "Origin stamps", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "why_miss", "name": "Why they miss it", "limit": 1 },
    { "type": "box_panel", "name": "Box panel (gift boxes)", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "contents", "name": "What's inside", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "What's inside" },
        { "type": "text", "id": "note", "label": "Note", "default": "If an item is out of stock, we swap in a Michigan classic of equal or greater value." }
      ]
    },
    {
      "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "dynamic_checkout", "label": "Show Shop Pay / dynamic checkout", "default": true },
        { "type": "range", "id": "cutoff_hour", "label": "Same-day ship cutoff (ET, 24h)", "min": 9, "max": 17, "step": 1, "default": 13 }
      ]
    },
    {
      "type": "perks", "name": "Perks", "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "Free handwritten gift note. Prices never go inside." },
        { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "Arrives crushed or melted? Send a photo and we'll resend it. Nothing to return." },
        { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "Free shipping on gift boxes and orders $75+" }
      ]
    },
    {
      "type": "complementary", "name": "Add-ons (complementary)", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Make it a bigger hug" },
        { "type": "range", "id": "limit", "label": "Products", "min": 1, "max": 4, "step": 1, "default": 3 },
        { "type": "paragraph", "content": "Set complementary products with the Search & Discovery app." }
      ]
    },
    {
      "type": "accordion", "name": "Accordion", "limit": 1,
      "settings": [
        { "type": "richtext", "id": "shipping_text", "label": "Shipping & returns text", "default": "<p>Packed by hand in Michigan and shipped Monday–Friday. Food can't be returned, but if anything arrives damaged or melted, send a photo within 7 days and we'll replace or refund it.</p>" },
        { "type": "text", "id": "extra_title", "label": "Extra tab title", "default": "Is it really Michigan-only?" },
        { "type": "richtext", "id": "extra_text", "label": "Extra tab text", "default": "<p>Everything we carry is made by a Michigan company and is hard to find outside the state. We're an independent shop and aren't affiliated with the brands we resell.</p>" }
      ]
    }
  ],
  "settings": []
}
{% endschema %}
