<section class="page-width section">
  <span class="kicker">{{ 'search.kicker' | t }}</span>
  <h1 style="font-size:clamp(2.2rem,4.5vw,3.6rem)">{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="field-row" style="max-width:640px;margin-bottom:32px">
    <input type="hidden" name="type" value="product">
    <label class="visually-hidden" for="SearchPage">{{ 'general.search' | t }}</label>
    <input class="input" id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
    <button class="btn" type="submit">{{ 'general.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p>{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results_count > 0 -%}
        <div class="grid grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="card"><div class="card__body"><span class="card__region">{{ item.object_type }}</span><h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3><p class="card__origin">{{ item.content | strip_html | truncatewords: 20 }}</p></div></article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>{{ 'search.no_results' | t }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
