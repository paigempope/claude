{%- comment -%}
  "What do they miss most?" gift finder: pick up to 3 cravings and get
  recommendations. Each option maps to a collection; the result routes to the best
  match (one pick) or to a box (2+ picks).
{%- endcomment -%}
<section class="section section--tight" data-quiz>
  <div class="page-width">
    <div class="quiz">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 style="margin-bottom:.2em">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.subheading }}</p>
      <div class="quiz__options">
        {%- for block in section.blocks -%}
          <button type="button" class="quiz__option" aria-pressed="false" data-quiz-option data-url="{{ block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {% render 'icon', name: block.settings.icon %}{{ block.settings.label }}
          </button>
        {%- endfor -%}
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
        <a class="btn" href="{{ routes.all_products_collection_url }}" data-quiz-go data-box-url="{{ section.settings.box_link | default: routes.all_products_collection_url }}" aria-disabled="true">{{ section.settings.button }}</a>
        <span class="form-note" style="margin:0">{{ section.settings.note }}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift finder quiz",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "so, who's it for?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What do they miss most?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick up to three and we'll point you to the right box." },
    { "type": "text", "id": "button", "label": "Button", "default": "Show me gifts" },
    { "type": "url", "id": "box_link", "label": "Link when 2+ picked", "info": "Usually your Build a Box page." },
    { "type": "text", "id": "note", "label": "Note", "default": "Takes 10 seconds. No email needed." }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "option",
      "name": "Option",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{"value":"chips","label":"Chip bag"},{"value":"pop","label":"Pop can"},{"value":"fudge","label":"Fudge"},{"value":"cherry","label":"Cherries"},{"value":"nut","label":"Peanut"},{"value":"pine","label":"Pine tree"},{"value":"mug","label":"Coffee mug"},{"value":"jar","label":"Jar"},{"value":"bottle","label":"Sauce bottle"},{"value":"lighthouse","label":"Lighthouse"},{"value":"crate","label":"Crate"},{"value":"gift","label":"Gift"},{"value":"box","label":"Box"},{"value":"wave","label":"Lake waves"},{"value":"mitten","label":"Mitten"}], "default": "chips" },
        { "type": "text", "id": "label", "label": "Label", "default": "Chips" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift finder quiz",
      "blocks": [
        { "type": "option", "settings": { "icon": "chips", "label": "Better Made chips" } },
        { "type": "option", "settings": { "icon": "pop", "label": "Faygo & Vernors" } },
        { "type": "option", "settings": { "icon": "fudge", "label": "Fudge & Sanders" } },
        { "type": "option", "settings": { "icon": "cherry", "label": "Up North cherries" } },
        { "type": "option", "settings": { "icon": "nut", "label": "Germack nuts" } },
        { "type": "option", "settings": { "icon": "pine", "label": "The U.P." } },
        { "type": "option", "settings": { "icon": "mug", "label": "Coffee & breakfast" } },
        { "type": "option", "settings": { "icon": "bottle", "label": "Hot sauce & pantry" } }
      ]
    }
  ]
}
{% endschema %}
