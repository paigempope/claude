{%- comment -%}
  Interactive "Shop by region" map. Each block is a pin on an accurate Michigan
  outline (viewBox 600x640). Clicking a pin or tab swaps the panel.
{%- endcomment -%}
<section class="section section--{{ section.settings.scheme }}" data-region-map>
  <div class="page-width">
    <div class="region-map">
      <div class="region-map__svg-wrap reveal">
        <svg class="region-map__svg" viewBox="0 0 600 640" role="group" aria-label="{{ section.settings.heading | escape }}">
          {% render 'michigan-shape', path_only: true, fill_class: 'region-map__land' %}
          {%- for block in section.blocks -%}
            {%- assign lx = 18 -%}{%- assign anchor = 'start' -%}
            {%- if block.settings.label_left -%}{%- assign lx = -18 -%}{%- assign anchor = 'end' -%}{%- endif -%}
            <g class="region-pin{% if forloop.first %} is-active{% endif %}" transform="translate({{ block.settings.x }} {{ block.settings.y }})" data-region-pin="{{ block.id }}" tabindex="0" role="button" aria-label="{{ block.settings.name | escape }}" {{ block.shopify_attributes }}>
              <circle class="pulse" r="10"/>
              <circle class="dot" r="9"/>
              <text x="{{ lx }}" y="5" text-anchor="{{ anchor }}">{{ block.settings.name }}</text>
            </g>
          {%- endfor -%}
        </svg>
      </div>

      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede" style="margin-bottom:24px">{{ section.settings.subheading }}</p>
        <div class="region-tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button type="button" class="region-tab" role="tab" id="tab-{{ block.id }}" aria-controls="panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-region-tab="{{ block.id }}">{{ block.settings.name }}</button>
          {%- endfor -%}
        </div>
        {%- for block in section.blocks -%}
          <div class="region-panel" role="tabpanel" id="panel-{{ block.id }}" aria-labelledby="tab-{{ block.id }}" data-region-panel="{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            <ul class="region-panel__items">
              {%- assign items = block.settings.items | split: ',' -%}
              {%- for it in items -%}<li>{{ it | strip }}</li>{%- endfor -%}
            </ul>
            {%- if block.settings.collection != blank -%}
              <a class="btn btn--light" href="{{ block.settings.collection.url }}">{{ 'collections.shop_region' | t: region: block.settings.name }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by region map",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [{ "value": "navy", "label": "Navy" }, { "value": "paper", "label": "Paper" }], "default": "navy" },
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "so, where are they from?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by where you grew up" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A Yooper and a Detroiter miss very different things. Tap a pin to see each region's classics." }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Region pin",
      "settings": [
        { "type": "text", "id": "name", "label": "Pin label", "default": "Detroit" },
        { "type": "range", "id": "x", "label": "X position", "min": 0, "max": 600, "step": 1, "default": 300 },
        { "type": "range", "id": "y", "label": "Y position", "min": 0, "max": 640, "step": 1, "default": 400 },
        { "type": "checkbox", "id": "label_left", "label": "Put label left of pin", "default": false },
        { "type": "text", "id": "title", "label": "Panel title" },
        { "type": "textarea", "id": "description", "label": "Panel text" },
        { "type": "text", "id": "items", "label": "Classics (comma separated)" },
        { "type": "collection", "id": "collection", "label": "Region collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by region map",
      "blocks": [
        { "type": "region", "settings": { "name": "Metro Detroit", "x": 525, "y": 567, "label_left": true, "title": "Metro Detroit & Ann Arbor", "description": "Gratiot Avenue chips, Eastern Market nuts and a century of Detroit pop. For the deep-cut Detroit stuff, our sister shop Detroit Gift Store has it all.", "items": "Better Made, Faygo, Vernors, Sanders, Germack, Kar's, Jiffy (Chelsea)" } },
        { "type": "region", "settings": { "name": "West Michigan", "x": 342, "y": 510, "label_left": true, "title": "West Michigan", "description": "Grand Rapids peanut butter, lakeshore towns and Cereal City, Battle Creek.", "items": "Koeze Cream-Nut, Old Orchard, Battle Creek cereal history" } },
        { "type": "region", "settings": { "name": "Up North", "x": 345, "y": 339, "label_left": true, "title": "Up North", "description": "Cherry country. Dunes, orchards and the fudge shops at the Straits.", "items": "Cherry Republic, American Spoon, Great Lakes chips, Mackinac fudge" } },
        { "type": "region", "settings": { "name": "The U.P.", "x": 229, "y": 168, "title": "The Upper Peninsula", "description": "Yooper country: Finnish rusks, thimbleberry jam and a chocolate bar shaped like home.", "items": "Trenary Toast, Jampot thimbleberry jam, Yooper Bar" } },
        { "type": "region", "settings": { "name": "The Thumb", "x": 532, "y": 432, "label_left": true, "title": "The Thumb & Bay", "description": "Sugar beets, navy beans, Pinconning cheese and Frankenmuth chicken-dinner noodles.", "items": "Pioneer Sugar, Zehnder's noodles, Michigan navy beans" } }
      ]
    }
  ]
}
{% endschema %}
