<section class="section{% if section.settings.tight %} section--tight{% endif %}{% if section.settings.scheme != 'none' %} section--{{ section.settings.scheme }}{% endif %}">
  <div class="page-width" style="max-width:860px;text-align:{{ section.settings.align }}">
    {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte lede" style="max-width:none">{{ section.settings.text }}</div>
    {%- if section.settings.cta_label != blank -%}<p class="mt-l"><a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a></p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [{ "value": "none", "label": "Birch" }, { "value": "paper", "label": "Paper" }, { "value": "navy", "label": "Navy" }, { "value": "pine", "label": "Pine" }], "default": "none" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "text", "id": "kicker", "label": "Handwritten kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "tight", "label": "Less padding", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
