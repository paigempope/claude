<section class="section{% if section.settings.paper %} section--paper{% endif %}">
  <div class="page-width story{% if section.settings.reverse %} story--reverse{% endif %}">
    <div class="story__media reveal">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500,800,1100', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt | default: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if section.settings.tag != blank -%}<span class="story__tag stamp stamp--solid">{{ section.settings.tag }}</span>{%- endif -%}
    </div>
    <div class="reveal">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte lede" style="max-width:none">{{ section.settings.text }}</div>
      {%- if section.settings.stat1 != blank -%}
        <div class="stats">
          <div class="stat"><b>{{ section.settings.stat1 }}</b><span>{{ section.settings.stat1_label }}</span></div>
          {%- if section.settings.stat2 != blank -%}<div class="stat"><b>{{ section.settings.stat2 }}</b><span>{{ section.settings.stat2_label }}</span></div>{%- endif -%}
          {%- if section.settings.stat3 != blank -%}<div class="stat"><b>{{ section.settings.stat3 }}</b><span>{{ section.settings.stat3_label }}</span></div>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.signature != blank -%}<p class="story__signature">{{ section.settings.signature }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}<a class="btn btn--navy" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story (image + text)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Real photo of your packing table or team. Authentic beats stock." },
    { "type": "text", "id": "tag", "label": "Stamp on image", "default": "Packed in Michigan" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "checkbox", "id": "paper", "label": "White background", "default": true },
    { "type": "text", "id": "kicker", "label": "Handwritten kicker", "default": "so, who packs these?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Michiganders, packing for Michiganders." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We grew up on Better Made in the lunchbox, Vernors when we were sick and fudge from the Straits every summer. Then friends started moving to Austin, Denver and Charlotte, and the texts came in: <em>can you send me some Rock & Rye?</em></p><p>So we built the store we wanted to order from. Every item has a Michigan address, every box is packed by hand in Michigan, and every card is written by a real person.</p>" },
    { "type": "text", "id": "stat1", "label": "Stat 1", "default": "100%" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Michigan-made brands" },
    { "type": "text", "id": "stat2", "label": "Stat 2", "default": "50" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "states we ship to" },
    { "type": "text", "id": "stat3", "label": "Stat 3", "default": "1 day" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "to pack & ship" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "— The Michigan Gift Store crew" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Read our story" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Story (image + text)" }]
}
{% endschema %}
