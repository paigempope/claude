<section class="section section--tight{% if section.settings.paper %} section--paper{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center">
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="values">
      {%- for block in section.blocks -%}
        <div class="value reveal" {{ block.shopify_attributes }}>
          <span class="value__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Handwritten kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "paper", "label": "Paper background", "default": false }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "gift", "label": "Gift" }, { "value": "shield", "label": "Shield" },
          { "value": "snow", "label": "Ice pack" }, { "value": "pin", "label": "Pin" }, { "value": "heart", "label": "Heart" },
          { "value": "box", "label": "Box" }, { "value": "building", "label": "Building" }, { "value": "calendar", "label": "Calendar" }
        ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ships next business day" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        { "type": "value", "settings": { "icon": "pin", "title": "Michigan-only, really", "text": "If you can buy it at your local grocery store, it's not in our boxes." } },
        { "type": "value", "settings": { "icon": "gift", "title": "Handwritten card", "text": "Your note, written by hand. Prices never go inside." } },
        { "type": "value", "settings": { "icon": "snow", "title": "Melt-safe summers", "text": "Chocolate and fudge ship with cold packs from May through September." } },
        { "type": "value", "settings": { "icon": "shield", "title": "Arrives right, or we resend", "text": "Crushed, melted or leaking? Send us a photo and we'll replace it. No need to ship anything back." } }
      ]
    }
  ]
}
{% endschema %}
