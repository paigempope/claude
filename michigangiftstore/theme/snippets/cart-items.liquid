{%- comment -%} Line items shared by the cart drawer and cart page. {%- endcomment -%}
{%- assign dest_count = 0 -%}
{%- for item in cart.items -%}
  {%- assign send_to = item.properties['Send to'] | default: '' -%}
  {%- assign needs_addr = false -%}
  {%- if send_to contains 'Ship to' -%}
    {%- assign dest_count = dest_count | plus: 1 -%}
    {%- if dest_count > 1 -%}{%- assign needs_addr = true -%}{%- endif -%}
  {%- endif -%}
  <div class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
    <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
      {%- if item.image -%}
        {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
    <div>
      <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
      <div class="cart-item__meta">
        {%- unless item.product.has_only_default_variant -%}{{ item.variant.title }}<br>{%- endunless -%}
        {%- for p in item.properties -%}
          {%- assign first_char = p.first | slice: 0 -%}
          {%- if p.last != blank and first_char != '_' -%}{{ p.first }}: {{ p.last }}<br>{%- endif -%}
        {%- endfor -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <span class="stamp stamp--cherry">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</span>
        {%- endfor -%}
      </div>
      <div class="qty-mini">
        <button type="button" data-qty-change="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}">−</button>
        <span>{{ item.quantity }}</span>
        <button type="button" data-qty-change="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}">+</button>
      </div>
      <button type="button" class="cart-item__remove" data-qty-change="0">{{ 'cart.remove' | t }}</button>
      {%- if needs_addr -%}
        {%- if send_to contains 'me' -%}{%- assign who = 'you' -%}{%- else -%}{%- assign who = item.properties['Recipient'] | default: item.product.title -%}{%- endif -%}
        {%- capture attr_name -%}Address for {{ who }} ({{ item.product.title }}, line {{ forloop.index }}){%- endcapture -%}
        <div class="addr-need">
          <label class="label" for="Addr-{{ item.key | handle }}">{{ 'cart.other_address' | t: who: who }}</label>
          <textarea class="input" id="Addr-{{ item.key | handle }}" data-cart-attribute="{{ attr_name | escape }}" placeholder="Street, city, state, ZIP">{{ cart.attributes[attr_name] }}</textarea>
          <p class="form-note">{{ 'cart.other_address_note' | t }}</p>
        </div>
      {%- endif -%}
    </div>
    <div class="cart-item__price">
      {{ item.final_line_price | money }}
      {%- if item.original_line_price > item.final_line_price -%}<br><s style="font-weight:400;color:var(--ink-soft)">{{ item.original_line_price | money }}</s>{%- endif -%}
    </div>
  </div>
{%- endfor -%}
