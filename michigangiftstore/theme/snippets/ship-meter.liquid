{%- comment -%} Free shipping progress meter, driven by settings.free_shipping_threshold. {%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign pct = cart.total_price | times: 100 | divided_by: threshold
  if pct > 100
    assign pct = 100
  endif
-%}
{%- if threshold > 0 -%}
  <div class="ship-meter">
    {%- if remaining > 0 -%}
      <p>{{ 'cart.free_shipping_remaining_html' | t: amount: remaining | money }}</p>
    {%- else -%}
      <p>{{ 'cart.free_shipping_unlocked_html' | t }}</p>
    {%- endif -%}
    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}"><div class="progress__bar" style="width: {{ pct }}%"></div></div>
  </div>
{%- endif -%}
